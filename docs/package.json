{
  "name": "crabpdf-website",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./site/styles/input.css -o ../dist/site/site/assets/site.css --minify",
    "build": "npm run build:css && node ./site/build.mjs",
    "check": "node --check ./site/app.js && node ./site/check.mjs",
    "dev": "tailwindcss -i ./site/styles/input.css -o ../dist/site/site/assets/site.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
